# Vercel Marketplace → Upstash Redis integration
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Upstash QStash: durable turn timeout and AI scheduling
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# The canonical production URL without a trailing slash, e.g. https://dca.example.com
DCA_APP_ORIGIN=

# Generate a long random secret. Never reuse the development fallback in production.
DCA_SESSION_SECRET=

# Optional retention controls
# DCA_ROOM_TTL_SECONDS=129600
# DCA_FINISHED_ROOM_TTL_SECONDS=14400
# DCA_PUBLIC_ROOM_MAX_AGE_MS=43200000